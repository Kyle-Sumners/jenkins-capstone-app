pipeline {
  agent any

  parameters {
    string(name: 'rollbackVersion', defaultValue: 'stable', description: 'Deployment image to rollback to')
  }

  environment {
    IMAGE_REPO = "quay.io/ksumners66/jenkins-capstone"
    ROLLBACK_TAG = "${params.rollbackVersion}"
  }

  stages {
    stage("Rollback") {
      steps {
        script {
          sh 'docker pull $IMAGE_REPO:$ROLLBACK_TAG'

          def tags = sh(
            script: "docker image inspect --format '{{join .RepoTags \",\"}}' ${IMAGE_REPO}:${ROLLBACK_TAG}",
            returnStdout: true
          ).trim()

          def resolvedVersion = tags.split(',')
            .collect { it.tokenize(':').last() }
            .find { it ==~ /main-\d+/ } ?: params.rollbackVersion

          sh """ 
            docker rm -f capstone-app
            docker run -d -p 5000:5000 --name capstone-app -e VERSION=${resolvedVersion} ${IMAGE_REPO}:${ROLLBACK_TAG}
            curl --retry 3 --retry-delay 2 --retry-all-errors --fail docker:5000/health
          """
        }
      }
    }
  }
}